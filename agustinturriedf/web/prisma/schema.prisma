generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRAINER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProfileGender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum InvitationStatus {
  PENDING
  SENT
  CONSUMED
  EXPIRED
  REVOKED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ProvisioningStatus {
  PENDING
  READY
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  SUBJECT
}

model User {
  id           String           @id @default(cuid())
  firstName    String
  lastName     String
  email        String           @unique
  phone        String?
  photoUrl     String?
  birthDate    DateTime?
  gender       ProfileGender?
  heightCm     Int?
  weightKg     Int?
  passwordHash String
  passwordUpdatedAt DateTime?
  role         Role
  status       AccountStatus @default(ACTIVE)
  version      Int           @default(1)
  authVersion  Int           @default(1)
  archivedAt   DateTime?
  archivedByUserId String?
  archiveReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  studentProfile  StudentProfile?   @relation("StudentUserProfile")
  trainerStudents StudentProfile[]  @relation("TrainerToStudents")
  invitationsSent Invitation[]
  trainerConfig   TrainerConfig?    @relation("TrainerConfigOwner")
  resetToken      PasswordResetToken?
  recordedPayments PaymentHistory[] @relation("PaymentRecordedByUser")
  archivedUsers User[] @relation("ArchivedUsers")
  archivedByUser User? @relation("ArchivedUsers", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  auditEventsAsSubject AuditEvent[] @relation("AuditSubject")
  auditEventsAsActor AuditEvent[] @relation("AuditActor")

  @@index([role])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Invitation {
  id                      String           @id @default(cuid())
  email                   String
  role                    Role             @default(STUDENT)
  version                 Int              @default(1)
  tokenHash               String?          @unique
  expiresAt               DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  trainerId               String?
  firstName               String
  lastName                String
  phone                   String?
  birthDate               DateTime?
  gender                  ProfileGender?
  heightCm                Int?
  weightKg                Int?
  initialPaymentStartDate DateTime?
  status                  InvitationStatus @default(PENDING)
  deliveryStatus          InvitationDeliveryStatus @default(PENDING)
  consumedAt              DateTime?

  trainer User? @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  activationSessions ActivationSession[]
  auditEvents AuditEvent[]

  @@index([email])
  @@index([trainerId])
  @@index([expiresAt])
  @@index([status])
  @@index([role])
}

model StudentProfile {
  id        String        @id @default(cuid())
  userId    String        @unique
  trainerId String
  status    StudentStatus @default(ACTIVE)
  provisioningStatus ProvisioningStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User          @relation("StudentUserProfile", fields: [userId], references: [id], onDelete: Cascade)
  trainer      User          @relation("TrainerToStudents", fields: [trainerId], references: [id], onDelete: Restrict)
  routineFolder RoutineFolder?
  currentPayment CurrentPayment?
  paymentHistory PaymentHistory[]

  @@index([trainerId])
  @@index([status])
}

model ActivationSession {
  id          String   @id @default(cuid())
  invitationId String
  sessionHash String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([expiresAt])
}

model AuditEvent {
  id            String         @id @default(cuid())
  eventType     String
  subjectUserId String?
  invitationId  String?
  actorType     AuditActorType
  actorUserId   String?
  reason        String?
  summary       Json
  createdAt     DateTime       @default(now())

  subjectUser User? @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  invitation  Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  actorUser   User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, createdAt])
  @@index([invitationId, createdAt])
}

model OutboxMessage {
  id             String      @id @default(cuid())
  messageType    String
  resourceType   String
  resourceId     String
  idempotencyKey String      @unique
  payloadEncrypted String?
  status         OutboxStatus @default(PENDING)
  attempts       Int         @default(0)
  availableAt    DateTime    @default(now())
  leaseExpiresAt DateTime?
  fencingToken   String?
  failureCategory String?
  failureSummary String?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
}

model ThrottleBucket {
  id        String   @id @default(cuid())
  scope     String
  subject   String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, subject])
  @@index([resetAt])
}

model TrainerConfig {
  id                          String   @id @default(cuid())
  trainerId                   String   @unique
  defaultMonthlyAmountInCents Int      @default(3000000)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  trainer User @relation("TrainerConfigOwner", fields: [trainerId], references: [id], onDelete: Cascade)
}

model CurrentPayment {
  id               String   @id @default(cuid())
  studentProfileId String   @unique
  amountInCents    Int
  startDate        DateTime
  dueDate          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  paymentHistory PaymentHistory[]

  @@index([studentProfileId])
  @@index([dueDate])
  @@index([startDate])
}

model PaymentHistory {
  id               String   @id @default(cuid())
  studentProfileId String
  currentPaymentId String
  amountInCents    Int
  paymentDate      DateTime
  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  currentPayment CurrentPayment @relation(fields: [currentPaymentId], references: [id], onDelete: Cascade)
  recordedByUser User           @relation("PaymentRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([studentProfileId])
  @@index([paymentDate])
  @@index([recordedByUserId])
}

model RoutineFolder {
  id               String   @id @default(cuid())
  studentProfileId String   @unique
  displayName      String
  storageKey       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  files          RoutineFile[]

  @@index([studentProfileId])
}

model RoutineFile {
  id             String   @id @default(cuid())
  folderId       String
  originalName   String
  normalizedName String
  extension      String
  relativePath   String
  sizeBytes      Int
  observations   String?
  uploadedAt     DateTime @default(now())

  folder RoutineFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, normalizedName])
  @@index([folderId])
  @@index([uploadedAt])
}

model VideotecaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   VideotecaFolder?  @relation("VideotecaFolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children VideotecaFolder[] @relation("VideotecaFolderHierarchy")
  files    VideotecaFile[]

  @@index([updatedAt])
  @@index([parentId])
}

model VideotecaFile {
  id           String   @id @default(cuid())
  folderId     String
  originalName String
  normalizedName String
  extension    String
  mediaType    String
  relativePath String
  thumbnailPath String?
  sizeBytes    Int
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folder VideotecaFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([orderIndex])
  @@unique([folderId, normalizedName])
  @@unique([folderId, orderIndex])
}
